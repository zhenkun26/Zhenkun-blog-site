{"ghsa_id":"GHSA-wf3x-273g-mvxv","cve_id":null,"url":"https://api.github.com/advisories/GHSA-wf3x-273g-mvxv","html_url":"https://github.com/advisories/GHSA-wf3x-273g-mvxv","summary":"devalue: Sparse arrays emitted by uneval cause eager allocation when evaluated","description":"Evaluating legitimate `uneval` output for a sparse array can allocate memory proportional to its declared length. A tiny serialized value can therefore cause large memory allocation in a consuming browser/runtime. This occurs during evaluation of generated code, not in default `parse` sparse-array construction.\n\nYou would only be affected by this if you were serializing very large sparse arrays and then evaluating the results. In the general use case for `uneval` of sending data to the client, the worst that could happen is the browser tab running out of memory.","type":"reviewed","severity":"low","repository_advisory_url":"https://api.github.com/repos/sveltejs/devalue/security-advisories/GHSA-wf3x-273g-mvxv","source_code_location":"https://github.com/sveltejs/devalue","identifiers":[{"value":"GHSA-wf3x-273g-mvxv","type":"GHSA"}],"references":["https://github.com/sveltejs/devalue/security/advisories/GHSA-wf3x-273g-mvxv","https://github.com/sveltejs/devalue/commit/6861dbbb7e548849e48bce718e88747a298f7250","https://github.com/sveltejs/devalue/releases/tag/v5.9.3","https://github.com/advisories/GHSA-wf3x-273g-mvxv"],"published_at":"2026-10-01T15:17:13Z","updated_at":"2026-10-01T15:17:16Z","github_reviewed_at":"2026-10-01T15:17:13Z","nvd_published_at":null,"withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"npm","name":"devalue"},"vulnerable_version_range":">= 1.0.0, <= 5.9.2","first_patched_version":"5.9.3","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:N/AC:H/AT:P/PR:N/UI:P/VC:N/VI:N/VA:N/SC:N/SI:N/SA:L","score":2.3}},"cwes":[{"cwe_id":"CWE-400","name":"Uncontrolled Resource Consumption"},{"cwe_id"