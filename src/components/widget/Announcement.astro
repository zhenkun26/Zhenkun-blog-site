---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { announcementConfig } from "@/config/announcementConfig";
import I18nKey from "@/i18n/i18nKey";
import { createTranslator, getTranslation } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { getPageLocale } from "@/utils/deployment-contract";
import { localizedNavigationPath } from "@/utils/locale-pages";
import { url } from "@/utils/url-utils";

const uiLocale = getPageLocale(Astro.url.pathname, import.meta.env.BASE_URL);
const i18n = createTranslator(uiLocale);

const config = announcementConfig;

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
	variant?: "widget" | "banner";
}
const {
	class: className,
	style,
	widgetConfig,
	variant = "widget",
} = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;
---

<!-- 组件显示现在由sidebarLayoutConfig统一控制，无需检查config.enable -->
{variant === "banner" ? (
  <section
    aria-labelledby="construction-notice-title"
    data-pagefind-ignore
    class:list={["card-base mb-4 flex items-start gap-3 border-l-4 border-(--primary) p-4 sm:px-5", className]}
    style={style}
  >
    <span class="shrink-0 text-2xl leading-7" aria-hidden="true">🚧</span>
    <div class="min-w-0">
      <h2 id="construction-notice-title" class="text-base font-bold text-neutral-900 dark:text-neutral-100">
        {uiLocale === "en" ? getTranslation(uiLocale).uiConstructionTitle : config.title || i18n(I18nKey.announcement)}
      </h2>
      <p class="mt-1 text-sm leading-relaxed text-neutral-600 dark:text-neutral-300">
        {uiLocale === "en" ? getTranslation(uiLocale).uiConstructionBody : config.content}
      </p>
    </div>
  </section>
) : (
<WidgetLayout
  name={uiLocale === "en" ? i18n(I18nKey.announcement) : config.title || i18n(I18nKey.announcement)}
  showTitle={showTitle}
  id="announcement"
  class={className}
  style={style}
>
  <div>
    <!-- 公告栏内容 -->
    <div class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-3">
      {uiLocale === "en" ? getTranslation("en").uiAnnouncement : config.content}
    </div>

    <!-- 可选链接和关闭按钮 -->
    <div class="flex items-center justify-between gap-3">
      <div>
        {
          config.link && config.link.enable !== false && (
            <a
              href={url(localizedNavigationPath(config.link.url, uiLocale))}
              target={config.link.external ? "_blank" : "_self"}
              rel={config.link.external ? "noopener noreferrer" : undefined}
              class="btn-regular rounded-lg px-3 py-1.5 text-sm font-medium active:scale-95 transition-transform"
            >
              {uiLocale === "en" ? i18n(I18nKey.about) : config.link.text}
            </a>
          )
        }
      </div>

      {
        config.closable && (
          <button
            class="btn-regular rounded-lg h-8 w-8 text-sm hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
            onclick="this.closest('widget-layout').style.display='none'"
            aria-label={i18n(I18nKey.announcementClose)}
          >
            <Icon name="fa7-solid:xmark" class="text-sm" />
          </button>
        )
      }
    </div>
  </div>
</WidgetLayout>
)}
