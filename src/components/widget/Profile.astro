---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { getTranslation } from "@/i18n/translation";
import { getPageLocale } from "@/utils/deployment-contract";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";
import { ENGLISH_BIO } from "@/utils/locale-pages";
import { url } from "@/utils/url-utils";

const uiLocale = getPageLocale(Astro.url.pathname, import.meta.env.BASE_URL);
const text = getTranslation(uiLocale);

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;
---

<div class:list={["card-base", "p-3", className]} style={style}>
  <a
    aria-label={text.uiAbout}
    href={url(uiLocale === "en" ? "/en/about/" : "/about/")}
    class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95"
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
    >
      <Icon
        name="fa7-regular:address-card"
        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl"
      />
    </div>
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt={text.uiAvatar}
      class="profile-avatar-image mx-auto lg:w-full h-full lg:mt-0"
      loading="eager"
      fetchpriority="high"
      widths={[350]}
      sizes="350px"
    />
  </a>
  <div class="px-2">
    <div
      class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
    >
      {profileConfig.name}
    </div>
    <div
      class="h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"
    >
    </div>
    <div class="text-center text-neutral-400 mb-2.5 transition">
      {uiLocale === "en" ? ENGLISH_BIO : profileConfig.bio}
    </div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {profileConfig.links.length > 1 && profileConfig.links.map(item =>
                    {
                    const showName = item.showName;
                    const className = showName 
                        ? "btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95" 
                        : "btn-regular rounded-lg h-10 w-10 active:scale-90";

                    if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.url.startsWith("mailto:") ? text.uiEmail : item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class={className}>
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && (item.url.startsWith("mailto:") ? text.uiEmail : item.name)}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.url.startsWith("mailto:") ? text.uiEmail : item.name} href={url(item.url)} target="_blank" class={className}>
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && (item.url.startsWith("mailto:") ? text.uiEmail : item.name)}
                        </a>
                    }
                    }
            )}
            {profileConfig.links.length == 1 && (function(item){
                if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.url.startsWith("mailto:") ? text.uiEmail : item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {item.url.startsWith("mailto:") ? text.uiEmail : item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.url.startsWith("mailto:") ? text.uiEmail : item.name} href={url(item.url)} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                                <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                                {item.url.startsWith("mailto:") ? text.uiEmail : item.name}
                            </a>
                    }
            })(profileConfig.links[0])}
        </div>
  </div>
</div>
