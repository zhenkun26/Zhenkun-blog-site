---
import ArchivePanel from "@components/controls/ArchivePanel.astro";
import I18nKey from "@i18n/i18nKey";
import { createTranslator } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getPageLocale } from "@/utils/deployment-contract";

const uiLocale = getPageLocale(Astro.url.pathname, import.meta.env.BASE_URL);
const i18n = createTranslator(uiLocale);
---

<MainGridLayout title={i18n(I18nKey.archive)}>
  <ArchivePanel />
</MainGridLayout>
